{
  "description": "Suggest a Codex memory audit when the local memory store crosses a review threshold.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/memory_pressure_hook.py\" --host codex",
            "timeout": 5,
            "statusMessage": "Checking Codex memory pressure..."
          }
        ]
      }
    ]
  }
}
