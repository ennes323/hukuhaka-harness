{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Doc Reader request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "root",
    "task",
    "action",
    "paths",
    "symbols",
    "questions",
    "budget"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": ["context", "impact"]
    },
    "root": {
      "type": "string",
      "pattern": "^/"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": ["inspect", "plan", "change", "verify"]
    },
    "paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "symbols": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDocuments", "maxBytes"],
      "properties": {
        "maxDocuments": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  }
}
