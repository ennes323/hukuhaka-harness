{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hukuhaka/hukuhaka-harness/project-docs.schema.json",
  "title": "Project Docs manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "role",
          "status",
          "authority",
          "summary",
          "appliesTo",
          "readWhen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "contract",
              "operations",
              "decision",
              "guide",
              "research",
              "history"
            ]
          },
          "status": {
            "enum": [
              "current",
              "draft",
              "historical"
            ]
          },
          "authority": {
            "enum": [
              "normative",
              "advisory",
              "evidence"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "readWhen": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verifyWith": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
