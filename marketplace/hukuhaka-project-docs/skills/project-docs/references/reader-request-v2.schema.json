{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Doc Reader request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "mode", "root", "task", "action", "paths", "symbols", "questions", "budget"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 2},
    "requestId": {"type": "string", "pattern": "\\S"},
    "mode": {"enum": ["context", "impact"]},
    "root": {"type": "string", "pattern": "^/"},
    "task": {"type": "string", "pattern": "\\S"},
    "action": {"enum": ["inspect", "plan", "change", "verify"]},
    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "symbols": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question"],
        "properties": {
          "id": {"type": "string", "pattern": "\\S"},
          "question": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDocuments", "maxBytes"],
      "properties": {
        "maxDocuments": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  }
}
